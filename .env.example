# Copie para .env em desenvolvimento local. No Railway, cadastre em Variables.
DATABASE_URL=postgres://usuario:senha@localhost:5432/bi_instructiva
# Use "true" apenas se o banco exigir SSL (conexão externa). Na rede interna do Railway, deixe false.
DATABASE_SSL=false
# Texto longo e aleatório. Nunca comite o valor real.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio
# Superadministrador criado automaticamente na primeira inicialização
ADMIN_EMAIL=admin@instructiva.com.br
ADMIN_SENHA=troque-esta-senha
# URL pública, usada nos links de redefinição de senha
APP_URL=http://localhost:3000
TV_CHAVE=troque-por-texto-aleatorio
